{
  "name": "dsh-answer-reviewer",
  "description": "dsh host plugin: every agent turn's final assistant output is reviewed by a separate LLM graded 1-100; below-threshold scores steer the agent with concrete feedback. Live config via 127.0.0.1 HTTP server, no host restart needed. Also exposed as a right-sidebar tab through dsh-better-sidebar.",
  "version": "0.5.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./review": {
      "default": "./lib/review.js"
    },
    "./config-store": {
      "default": "./lib/config-store.js"
    },
    "./server": {
      "default": "./lib/server.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CONFIGURE.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": ["betterSidebar"],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "^0.1.2-alpha.1 || ^0.1.3-alpha.1",
    "@deepseek-ai/dsh-session": "^0.1.2-alpha.1 || ^0.1.3-alpha.1"
  },
  "license": "MIT"
}
